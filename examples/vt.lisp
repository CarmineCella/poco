(define x [1 2 3 4])
(display "x*2      " (* x 2))
(display "2*x      " (* 2 x))
(display "x+x      " (+ x x))
(display "3+4      " (+ 3 4))
(display "1/x      " (/ 1 x))
(display "x<3      " (< x 3))
(display "sqrt     " (sqrt [4 9 16]))
(display "sin 0    " (sin 0))
(display "pow      " (pow x 2) (pow 2 x))
(display "sum mean " (sum x) (/ (sum x) (size x)))
(display "min max  " (min x) (max x))
(display "shift    " (shift x 1) (cshift x -1))
(display "ref      " (ref x 2))
(display "neg      " (neg x))
(display "if on array: first element" (if (< x 3) "yes" "no") (if (> x 3) "yes" "no"))
; the prelude still works: map over a list of arrays
(define map (lambda (f l) (if (null? l) '() (cons (f (car l)) (map f (cdr l))))))
(display "map      " (map (lambda (a) (sum a)) (list [1 2] [3 4] [5 6 7])))
; vector code written in the language: dot product, norm, linspace-like range
(define dot  (lambda (a b) (sum (* a b))))
(define norm (lambda (a) (sqrt (dot a a))))
(display "dot norm " (dot x x) (norm [3 4]))
(define fib (lambda (n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2))))))
(display "fib 15   " (fib 15))
(display "fib on a vector of n?" (* [1 1] (fib 10)))
