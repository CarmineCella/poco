# Count 0..4
set i 0
lt running i 5
while running
    print i
    add i i 1
    lt running i 5
endwhile
# nested conditions
set x 3
gt cond x 0
if cond
    lt small x 4
    if small
        print 111
    else
        print 222
    endif
else
    print 333
endif
# test skipped while
set count 0
while count
    print 999
endwhile
# recursive function containing if
proc fact n
    lt base n 2
    if base
        return 1
    else
        sub prev n 1
        call smaller fact prev
        mul result n smaller
        return result
    endif
end
call result fact 5
print result
# vectorization
vec a 1 2 3
mul b a 2
print b
