(display "arith" (+ 1 2) (* 3 4) (- 10 4) (/ 1 4))
(display "lists" (car '(1 2 3)) (cdr '(1 2 3)) (cons 0 '(1 2)) (list 1 2 3) (null? '()))
(define fib (lambda (n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2))))))
(display "fib 20 =" (fib 20))
(display "map" (map (lambda (x) (* x x)) (range 0 6)))
(display "filter" (filter (lambda (x) (> x 2)) (range 0 6)))
(display "fold" (fold + 0 (range 1 101)))
(display "length" (length (range 0 10)))
(define c (make-counter))
(c) (c)
(display "counter" (c))
(define d (make-counter))
(display "independent counters" (d) (c))
(define loop (lambda (i acc) (if (= i 0) acc (loop (- i 1) (+ acc 1)))))
(display "tail recursion 1e6 deep:" (loop 1000000 0))
(define compose (lambda (f g) (lambda (x) (f (g x)))))
(define inc (lambda (x) (+ x 1)))
(display "compose" ((compose inc inc) 5))
(display "quote" '(a b (c d)) 'sym "a string with spaces")
(display "if false branch" (if 0 1 2) (if '() 1 2) (if 5 1 2))
