(check 'normalize-pad-repeat (cat (normalize [1 -4]) (cat (pad [1] 2) (repeat [1 2] 2))) [0.25 -1 1 0 0 1 2 1 2])
(check 'map-array (map-array (lambda (v) (* v 10)) [1 2]) [10 20])
(check 'time-sine (near (cat (time 4 2) (sine 1 [0 0.25])) [0 0.5 1 1.5 0 1]) 1)
