(load "prelude.lisp")
(define passed 0) (define failed 0)
(define (check name got want) (if (equal? got want) (set! passed (+ passed 1)) {
    (set! failed (+ failed 1))
    (display "FAIL" name got want)
}))
(define (near a b) (< (max (abs (- a b))) 1e-9))
(check "not and or" (list (not 0) (not 1) (and 1 0) (or 0 1)) '(1 0 0 1))
(check "any all" (list (any [0 1]) (all [0 1]) (all [2 1])) '(1 0 1))
(check "map on an array" (map square [1 2 3]) [1 4 9])
(check "map on a list of scalars gives an array" (map square '(1 2 3)) [1 4 9])
(check "map on a list of strings gives a list" (map (lambda (v) (cat v "!")) (list "a" "b")) (list "a!" "b!"))
(check "fold" (list (fold + 0 '(1 2 3)) (fold + 0 [1 2 3]) (fold cat "" (list "a" "b"))) (list 6 6 "ab"))
(check "filter keeps the kind" (list (filter (lambda (v) (> v 1)) '(1 2 3)) (filter (lambda (v) (> v 1)) [1 2 3]) (filter (lambda (c) (equal? c "a")) "banana")) (list '(2 3) [2 3] "aaa"))
(check "reverse" (list (reverse [1 2 3]) (reverse (list "a" "b"))) (list [3 2 1] (list "b" "a")))
(check "zip" (zip '(1 2) '(a b)) '((1 a) (2 b)))
(check "first last rest" (list (first '(a b c)) (last '(a b c)) (rest "abc") (empty? (list)) (empty? [1])) (list 'a 'c "bc" 1 0))
(check "index-of" (list (index-of 'b '(a b c)) (index-of 9 [1 2]) (index-of "n" "banana")) '(1 -1 2))
(check "for-each" {
    (define acc 0)
    (for-each (lambda (v) (set! acc (+ acc v))) [1 2 3])
    acc
} 6)
(check "zip" (zip '(1 2) '(a b c)) '((1 a) (2 b)))
(check "count" (count (lambda (v) (> v 1)) '(1 2 3)) 2)
(check "mod" (mod [7 -7 7.5] 3) [1 2 1.5])
(check "round ceil sign" (list (round [1.4 1.6 -1.5]) (ceil [1.2 -1.2]) (sign [-3 0 2])) (list [1 2 -1] [2 -1] [-1 0 1]))
(check "log10 log2" (near (list->array (list (log10 1000) (log2 8))) [3 3]) 1)
(check "clip" (clip [-5 0.5 5] 0 1) [0 0.5 1])
(check "minimum maximum" (list (minimum [1 5] [3 2]) (maximum [1 5] [3 2])) (list [1 2] [3 5]))
(check "linspace" (near (linspace 0 1 5) [0 0.25 0.5 0.75 1]) 1)
(check "first rest head tail" (list (first [1 2 3]) (rest [1 2 3]) (head [1 2 3] 2) (tail [1 2 3] 2)) (list 1 [2 3] [1 2] [2 3]))
(check "diff cumsum" (list (diff [1 4 9]) (cumsum [1 2 3])) (list [3 5] [1 3 6]))
(check "argmax argmin" (list (argmax [1 9 3 9]) (argmin [1 9 -3])) '(1 2))
(check "dot norm" (list (dot [1 2] [3 4]) (norm [3 4])) '(11 5))
(check "mean var std rms" (near (list->array (list (mean [2 4]) (var [2 4]) (std [2 4]) (rms [3 4]))) [3 1 1 3.5355339059327378]) 1)
(check "normalize" (normalize [1 -4]) [0.25 -1])
(check "pad repeat" (list (pad [1] 2) (repeat [1 2] 2)) (list [1 0 0] [1 2 1 2]))
(check "cshift" (list (cshift [1 2 3 4] 1) (cshift [1 2 3 4] -1) (cshift [] 2)) (list [2 3 4 1] [4 1 2 3] []))
(check "min" (min [3 1 2]) 1)
(check "time" (time 4 2) [0 0.5 1 1.5])
(check "sine" (near (sine 1 [0 0.25]) [0 1]) 1)
(check "phasor saw pulse" (list (phasor 1 4 4) (saw 1 4 4) (pulse 1 4 4 0.5)) (list [0 0.25 0.5 0.75] [-1 -0.5 0 0.5] [1 1 0 0]))
(check "noise range" (and (<= (peak (noise 1000 1)) 1) (> (std (noise 1000 1)) 0.4)) 1)
(check "noise deterministic" (noise 5 7) (noise 5 7))
(check "db undb" (near (undb (db [0.5 2])) [0.5 2]) 1)
(check "mtof ftom" (near (list->array (list (mtof 69) (ftom 880))) [440 81]) 1)
(check "hann" (near (hann 4) [0 0.5 1 0.5]) 1)
(check "hamming ends" (near (ref (hamming 8) 0) 0.08) 1)
(check "blackman peak" (near (ref (blackman 8) 4) 1) 1)
(check "fades" (near (envelope (ones 6) 2) [0 1 1 1 1 0]) 1)
(check "delay" (delay [1 2 3] 1) [0 1 2])
(check "moving-average" (near (moving-average [1 1 1 1] 2) [1 1 1 1]) 1)
(check "convolve" (near (convolve [1 2 3] [1 1]) [1 3 5 3]) 1)
(define fs (frames (range 8) 4 2))
(check "frames" (list (len fs) (len (first fs))) '(3 4))
(check "overlap-add length" (len (overlap-add fs 4 2)) 8)
(check "overlap-add with rectangular frames" (overlap-add (list [1 1 1 1] [1 1 1 1]) 4 2) [1 1 2 2 1 1])
(check "energy zero-crossings peak" (list (energy [1 2]) (zero-crossings [1 -1 1 1]) (peak [-3 2])) '(5 2 3))
(check "compose" ((compose square (lambda (v) (+ v 1))) 2) 9)
(check "show returns" (show "x" 3) 3)
(display "passed" passed "failed" failed)
