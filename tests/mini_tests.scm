; the mini test suite: display prints symbols, so messages are symbols
(define passed 0)
(define failed 0)
(define equal? (lambda (a b) (if (= (len a) (len b)) (if (= (len a) 0) 1 (if (= (sum (= a b)) (len a)) 1 0)) 0)))
(define check (lambda (name got want) (if (equal? got want) (set! passed (+ passed 1)) { (set! failed (+ failed 1)) (display 'FAIL name got want) })))
(check 'add (+ [1 2] 1) [2 3])
(check 'sub (- 5 2) 3)
(check 'broadcast (* 2 [1 2 3]) [2 4 6])
(check 'compare (< [1 5 3] 3) [1 0 0])
(check 'sqrt (sqrt [4 9]) [2 3])
(check 'floor (floor [1.7 -1.2]) [1 -2])
(check 'range (range 4) [0 1 2 3])
(check 'empty-range (range 0) [])
(check 'slice (slice (range 10) 2 3) [2 3 4])
(check 'slice-end (slice (range 3) 3 0) [])
(check 'cat (cat [1] [2 3]) [1 2 3])
(check 'len (len [1 2 3]) 3)
(check 'sum (sum [1 2 3]) 6)
(check 'sum-empty (sum []) 0)
(check 'max (max [3 9 2]) 9)
(check 'ref (ref [10 20] 1) 20)
(check 'lambda ((lambda (a b) (- a b)) 5 3) 2)
(check 'closure ((lambda (a) ((lambda (b) (+ a b)) 10)) 1) 11)
(define fact (lambda (n) (if (< n 2) 1 (* n (fact (- n 1))))))
(check 'recursion (fact 10) 3628800)
(define loop (lambda (i acc) (if (= i 0) acc (loop (- i 1) (+ acc 1)))))
(check 'tail-calls (loop 100000 0) 100000)
(define make-counter (lambda () { (define n 0) (lambda () { (set! n (+ n 1)) n }) }))
(define c (make-counter))
(c) (c)
(check 'set!-in-closure (c) 3)
(check 'if-no-else (len (if 0 1)) 0)
(check 'truth-all (if [1 2] 1 0) 1)
(check 'truth-zero (if [1 0] 1 0) 0)
(check 'truth-empty (if [] 1 0) 0)
(check 'do {1 2 3} 3)
(check 'quote (car '(1 2)) 1)
(check 'list-len (len (list 1 2 3)) 3)
(check 'cdr (car (cdr '(1 2))) 2)
(check 'cons (car (cons 9 '())) 9)
(define map (lambda (f l) (if (= (len l) 0) '() (cons (f (car l)) (map f (cdr l))))))
(check 'map (car (cdr (map (lambda (v) (* v v)) '(2 3)))) 9)
(define literal (lambda () [1 2 3]))
(check 'literal-shared (literal) [1 2 3])
(define sine (lambda (f n) (sin (* (* 6.283185307179586 f) (/ (range n) n)))))
(check 'dsp (< (- (sum (* (sine 1 100) (sine 1 100))) 50) 1e-9) 1)
(display 'passed passed 'failed failed)
